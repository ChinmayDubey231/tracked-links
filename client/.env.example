# Copy to client/.env.local. These values are public: they end up in the browser bundle.

# Where the API runs.
VITE_API_URL=http://localhost:4000

# The public address of this frontend, used to build share links ([YOUR DOMAIN]/v/<slug>).
VITE_PUBLIC_BASE_URL=http://localhost:5173

# Optional. The repository URL for the GitHub link in the landing page footer; hidden when empty.
VITE_GITHUB_URL=https://github.com/ChinmayDubey231/tracked-links
