{
  "font": {
    "family": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "typeScale": {
    "display": { "size": 54, "weight": 800, "lineHeight": 1.1, "use": "Landing hero headline" },
    "section": { "size": 36, "weight": 800, "lineHeight": 1.2, "use": "Landing section headings" },
    "pageTitle": { "size": 32, "weight": 600, "lineHeight": 1.25, "use": "App page headlines" },
    "stat": { "size": 28, "weight": 600, "lineHeight": 1.25, "use": "Stat numbers, per-page seconds" },
    "statLarge": { "size": 24, "weight": 600, "lineHeight": 1.2, "use": "View counts in tables" },
    "cardTitle": { "size": 20, "weight": 600, "lineHeight": 1.3, "use": "Card headings" },
    "brand": { "size": 18, "weight": 700, "lineHeight": 1.4, "use": "Wordmark in the top bar" },
    "body": { "size": 15, "weight": 400, "lineHeight": 1.5, "use": "Default app text" },
    "bodyLanding": { "size": 16, "weight": 400, "lineHeight": 1.55, "use": "Default landing text" },
    "small": { "size": 14, "weight": 400, "lineHeight": 1.5, "use": "Secondary text, table cells, buttons" },
    "caption": { "size": 13, "weight": 400, "lineHeight": 1.5, "use": "Hints, footer, breadcrumbs" },
    "micro": { "size": 12, "weight": 400, "lineHeight": 1.5, "use": "Chart labels and legends" }
  },
  "color": {
    "ink": "#101418",
    "inkStrong": "#15171A",
    "muted": "#4A5460",
    "surface": "#FFFFFF",
    "page": "#F6F8FA",
    "viewerBackdrop": "#E6E9EE",
    "tableHeader": "#EDF1F5",
    "rule": "#E3E7EC",
    "ruleStrong": "#C5CCD6",
    "inputBorder": "#C5CCD6",
    "checkboxBorder": "#8A94A0",
    "brand": "#176B58",
    "brandText": "#155B4B",
    "brandHover": "#0E4337",
    "brandDeep": "#123C33",
    "brandDeepRaised": "#1A4B40",
    "brandDeepBorder": "#3F6E62",
    "brandTint": "#EDF5F3",
    "brandTintStrong": "#E3F1ED",
    "brandTintBorder": "#CFE3DC",
    "brandDashed": "#9CC4B8",
    "brandOnTint": "#074D40",
    "onDarkMuted": "#D7E6E0",
    "onDarkFaint": "#B5CFC4",
    "heat": "#D9402B",
    "heatLegend": ["#FCF1EF", "#F7D8D3", "#F1B9AF", "#E98D7F"],
    "accentLink": "#B5301D",
    "thumbLine": "#B7C0C5",
    "thumbHeading": "#16392F"
  },
  "radius": { "control": 8, "card": 12, "cardLarge": 16, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "14": 56, "18": 72 },
  "layout": {
    "containerMax": 1160,
    "gutter": 24,
    "topBarHeight": 70,
    "subHeaderHeight": 68,
    "footerHeight": 76,
    "minTouchTarget": 44
  },
  "shadow": {
    "previewWindow": "0 24px 60px rgba(0, 0, 0, 0.3)",
    "paper": "0 2px 8px rgba(16, 20, 24, 0.08)",
    "floatingPage": "0 12px 28px rgba(16, 20, 24, 0.1)",
    "toolbar": "0 1px 4px rgba(16, 20, 24, 0.12)"
  },
  "heatmap": {
    "rule": "overlay opacity = 0.6 * min(avgActiveSeconds, 50) / 50, floor 0.06",
    "legendRange": "0s to 50s+",
    "reachBar": "3px bar under each page, brand on brandTintStrong, width = share of views that reached the page"
  },
  "focus": "2px solid #176B58 outline, 2px offset, on every link, button and input"
}
