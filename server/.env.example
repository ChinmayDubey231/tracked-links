# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB. Local: mongodb://127.0.0.1:27017/tracked-links
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tracked-links
MONGODB_URI=mongodb://127.0.0.1:27017/tracked-links

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Salt mixed into viewer IP addresses before hashing. Raw IPs are never stored.
IP_HASH_SALT=

# Frontend origin(s) allowed by CORS, comma-separated. No trailing slash.
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the frontend, used in emails (phase 4).
PUBLIC_BASE_URL=http://localhost:5173
# Public URL of this API. Used to build signed file URLs with the local storage driver.
API_BASE_URL=http://localhost:4000

# Number of proxies in front of the API (Render: 1) so rate limits see the real client IP.
TRUST_PROXY=0

# File storage: "s3" or "local". If unset, S3 is used when the S3_* values are set, otherwise local disk.
# Check the bucket settings with: npm run storage:check -w server
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=./storage

# Private S3-compatible bucket: Backblaze B2 (Cloudflare R2 and AWS S3 also work).
# B2: the "Endpoint" shown on the Buckets page, e.g. s3.us-east-005.backblazeb2.com
S3_ENDPOINT=
# Optional. Read from the endpoint when empty ("us-east-005" above). Use "auto" for R2.
S3_REGION=
S3_BUCKET=
# B2: an application key limited to this bucket with Read and Write access (keyID and applicationKey).
# The master application key does not work with the S3 API.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# How long signed file URLs stay valid, in seconds.
SIGNED_URL_TTL_SECONDS=300
